# directories
.idea/
.vscode/
target/
bin/
# ...but not Rust `src/bin/` source dirs, which are real crate sources
!json_schema_rs_benchmark/src/bin/
!json_schema_rs_benchmark/isolated/src/bin/
!json_schema_rs_differential/src/bin/
research/repos/
research/json-schema-test-suite/

# Raw Bowtie reports are large and regenerated by `make differential`; the summarized
# results.{json,md} are committed instead
json_schema_rs_differential/reports/

# Specs are downloaded via make vendor_specs (./specs/download.sh), not stored in repo
specs/ietf/*
!specs/ietf/.gitkeep
specs/json-schema.org/*
!specs/json-schema.org/.gitkeep

# files
.DS_Store
Cargo.lock

# Benchmark competitor environments, installed from the committed lock files by `make benchmark_full`
json_schema_rs_benchmark/competitors/node/node_modules/
json_schema_rs_benchmark/competitors/python/.venv/
# reverse_codegen models generated from the fixtures by the driver (never committed)
json_schema_rs_benchmark/competitors/node/reverse-models/
json_schema_rs_benchmark/competitors/python/reverse-models/
__pycache__/
