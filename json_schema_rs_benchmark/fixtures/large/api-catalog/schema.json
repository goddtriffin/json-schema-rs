{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/large/api-catalog.json",
  "title": "ServiceCatalog",
  "description": "A catalog describing microservices, their endpoints, dependencies, deployment targets, and observability configuration. Hand-authored to exercise nested objects, arrays, enums, refs, allOf/oneOf, and numeric/string bounds while remaining fully supported by mainstream JSON Schema tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "generatedAt", "services"],
  "properties": {
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "$ref": "#/$defs/contact"
    },
    "environments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["dev", "staging", "prod"]
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "team": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMillicores", "memoryMib"],
      "properties": {
        "cpuMillicores": {
          "type": "integer",
          "minimum": 10,
          "maximum": 64000
        },
        "memoryMib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 262144
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "maxLength": 256
        },
        "deprecated": {
          "type": "boolean"
        },
        "auth": {
          "type": "string",
          "enum": ["none", "apiKey", "oauth2", "mtls"]
        },
        "rateLimitPerMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": ["http", "grpc", "database", "cache", "queue"]
        },
        "critical": {
          "type": "boolean"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricsEnabled": {
          "type": "boolean"
        },
        "tracingEnabled": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"]
        },
        "dashboards": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "tier", "endpoints"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "language": {
          "type": "string",
          "enum": ["rust", "go", "python", "typescript", "java", "csharp"]
        },
        "tier": {
          "type": "string",
          "enum": ["frontend", "backend", "data", "infra"]
        },
        "public": {
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/contact"
        },
        "resources": {
          "$ref": "#/$defs/resourceLimits"
        },
        "healthCheck": {
          "$ref": "#/$defs/healthCheck"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "observability": {
          "$ref": "#/$defs/observability"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    }
  }
}
